# Rust build artifacts
target/
**/*.rs.bk
Cargo.lock.bak

# g8 local substrate (each repo using g8 will have its own .g8/; we don't
# want this repo accidentally tracking a development store). .govern/ is the
# pre-rename directory name, still accepted by the binary.
.g8/store.db
.g8/store.db-wal
.g8/store.db-shm
.g8/store.db-journal
.g8/INTENT_SUMMARY.md
.govern/

# Editor / OS
*.swp
*.swo
.DS_Store
.idea/
.vscode/

# Local agent scratchpads
/scratch/

# Pre-git tarball snapshots (superseded by git history itself)
/.backup-*/

# Machine-local inventory + agent-harness state. These describe THIS checkout
# on THIS machine (adoption status, pane sessions, scratch transcripts) and
# say nothing about the code, so they never belong in a public history.
.ada/
.pane-*
.herdr/
.aider*
.codex/
.cursor/
.gemini/
.claude/settings.local.json
.claude/history/
.claude/projects/

# Local environment + secrets
.env
.env.*
!.env.example
.envrc
.direnv/
*.local.toml
*.local.json
*.local.yaml
*.pem
*.key
secrets/

# Local logs, profiles, and captures
*.log
*.profraw
/screenshots/
/captures/
